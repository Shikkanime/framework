<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.31.xsd">

    <changeSet id="create-liquibase-test-entry" author="shikkanime">
        <createTable tableName="liquibase_test_entry">
            <column name="id" type="INT">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="entry_name" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <insert tableName="liquibase_test_entry">
            <column name="id" valueNumeric="1"/>
            <column name="entry_name" value="Created by Liquibase"/>
        </insert>
    </changeSet>
</databaseChangeLog>
